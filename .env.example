POSTGRES_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
AUTH_JWT_SECRET=replace-with-32-plus-char-secret
AUTH_OTP_SALT=replace-with-8-plus-char-salt
APP_URL=https://drigic.rs
NEXT_PUBLIC_APP_URL=https://drigic.rs
NEXT_PUBLIC_SITE_URL=https://drigic.rs
CRON_SECRET=replace-with-random-secret

# Optional
RESEND_API_KEY=
RESEND_FROM=Dr Igic Clinic <obavestenja@drigic.rs>
RESEND_REPLY_TO=drigicclinic@gmail.com
ADMIN_BOOKING_NOTIFY_EMAIL=drigicclinic@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://drigic.rs/api/auth/google/callback
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:kontakt@drigic.rs
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=

# Google tag / Google Ads conversion tracking (all optional - empty = no tag loaded)
# GA4 measurement id
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Ads conversion id, e.g. AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Label part only of the "Zakazan termin" conversion action (AW-123456789/AbC-D_efGh -> AbC-D_efGh)
NEXT_PUBLIC_GOOGLE_ADS_BOOKING_LABEL=
